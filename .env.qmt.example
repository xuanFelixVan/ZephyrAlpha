# ============================================
# QMT交易接口敏感信息配置模板
# ============================================
# 使用说明:
# 1. 复制此文件为 .env.qmt
# 2. 填写实际的账号和密码
# 3. 切勿将 .env.qmt 提交到版本控制
# ============================================

# 模拟账户配置
QMT_SIMULATION_ACCOUNT=您的模拟账号
QMT_SIMULATION_PASSWORD=您的模拟密码

# 实盘账户配置
QMT_LIVE_ACCOUNT=您的实盘账号
QMT_LIVE_PASSWORD=您的实盘密码

# ============================================
# 安全提示:
# - 此文件已在 .gitignore 中配置，不会被git追踪
# - 请妥善保管您的账号密码
# - 建议定期更换密码
# - 实盘交易请谨慎操作
# ============================================
