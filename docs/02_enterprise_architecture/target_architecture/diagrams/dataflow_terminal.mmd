%%{init: {'theme': 'default'}}%%
%% Dataflow Terminal Diagram — ZephyrAlpha 2.0
%% 升级记录：2026-05-04 — 显式标注 P0 跨层数据契约 CTR-001~CTR-006 作为架构承重墙
%% 契约真源：architecture_model/contracts/cross_layer_contracts.yaml
%% 图例：🔒 = frozen (不可变契约)  |  🔓 = mutable (可变契约，状态机)
flowchart TD

    %% ── External Sources ──────────────────────────────────────────
    subgraph EXT["External Systems / 外部系统"]
        MD_EXT["Market Data Provider<br/>行情数据源<br/>(REST / WebSocket)"]
        ALT_EXT["Alternative Data<br/>另类数据源<br/>(REST / file)"]
        BROKER_EXT["Broker API<br/>券商 API<br/>(REST / FIX)"]
        LLM_EXT["LLM Providers<br/>LLM 服务商<br/>(REST)"]
        FEISHU_EXT["Feishu<br/>飞书<br/>(REST Webhook)"]
    end

    %% ── L00 Data Source ───────────────────────────────────────────
    subgraph L00["L00 · Data Source / 数据源层"]
        L00_CONN["connectors/<br/>数据源适配器"]
        L00_NORM["normalizers/<br/>标准化"]
        L00_QG["quality/<br/>质量门禁"]
        L00_STORE["storage/<br/>数据落库"]
        L00_CACHE["cache/<br/>缓存"]
    end

    %% ── L01 Infrastructure (cross-cutting) ───────────────────────
    L01["L01 · Infrastructure / 基础设施<br/>config · logging · exceptions · runtime<br/>配置 · 日志 · 异常 · 运行时<br/>⟵ 所有层依赖，省略连线"]

    %% ── L02 Alpha Factor ──────────────────────────────────────────
    subgraph L02["L02 · Alpha Factor / Alpha 因子层"]
        L02_BASE["FactorBase<br/>因子基类契约 🔒"]
        L02_REG["FactorRegistry<br/>因子注册表 🔒"]
        L02_FACTORS["factors/<br/>具体因子实现<br/>(可扩展 ∞)"]
        L02_EVAL["evaluation/<br/>IC · IR · 衰减评估"]
        L02_PIPE["pipeline/<br/>因子计算流水线"]
    end

    %% ── L03 Signal Generation ─────────────────────────────────────
    subgraph L03["L03 · Signal Generation / 信号生成层"]
        L03_SENT["sentiment/<br/>舆情分析"]
        L03_SIG["signals/<br/>复合信号构建"]
        L03_PRED["predictions/<br/>预测模型推理"]
    end

    %% ── L04 Risk Management ───────────────────────────────────────
    subgraph L04["L04 · Risk Management / 风险管理层"]
        L04_METRICS["metrics/<br/>VaR · CVaR · 回撤 · Beta"]
        L04_LIMITS["limits/<br/>持仓限额执行"]
        L04_SL["stop_loss/<br/>止损触发"]
        L04_MON["monitor/<br/>实时风险监控"]
    end

    %% ── L05 Portfolio Construction ────────────────────────────────
    subgraph L05["L05 · Portfolio Construction / 组合构建层"]
        L05_BASE["StrategyBase<br/>策略基类契约 🔒"]
        L05_REG["StrategyRegistry<br/>策略注册表 🔒"]
        L05_STRATS["strategies/<br/>具体策略实现<br/>(可扩展 ∞)"]
        L05_OPT["optimization/<br/>均值方差 · 风险平价"]
        L05_REB["rebalancing/<br/>再平衡计划生成"]
        L05_BT["backtest/<br/>事件驱动回测引擎"]
    end

    %% ── L06 Trade Execution ───────────────────────────────────────
    subgraph L06["L06 · Trade Execution / 交易执行层"]
        L06_PT["pre_trade/<br/>执行前风控"]
        L06_OMS["oms/<br/>委托生命周期 OMS"]
        L06_SOR["sor/<br/>智能路由 SOR"]
        L06_IFACE["BrokerInterface<br/>券商接口契约 🔒"]
        L06_ADP["adapters/<br/>具体券商适配器<br/>(可扩展 ∞)"]
    end

    %% ── L07 Post-Trade Analytics ──────────────────────────────────
    subgraph L07["L07 · Post-Trade Analytics / 交易后分析层"]
        L07_ATTR["attribution/<br/>绩效归因"]
        L07_REV["review/<br/>执行质量 TCA · 滑点"]
        L07_RPT["reports/<br/>报告生成"]
    end

    %% ── L08 Human-AI Interface ────────────────────────────────────
    subgraph L08["L08 · Human-AI Interface / 人机交互层"]
        L08_CLI["cli/<br/>操作者入口"]
        L08_ORCH["orchestration/<br/>人机协作编排"]
        L08_NOTIF["notifications/<br/>飞书 · 告警分发"]
    end

    %% ── L10 Governance (横切) ─────────────────────────────────────
    L10["L10 · Governance & Compliance / 治理合规<br/>合规校验 · 审计痕迹 · 规则引擎<br/>⟵ 横向贯穿所有业务层"]

    %% ── L11 Strategic Decision ────────────────────────────────────
    L11["L11 · Strategic Decision / 战略决策<br/>长期配置 · 决策支持 · 战略报告<br/>⟵ 消费所有层输出"]

    %% ── AI Agent Ops (L09 / 08_ai_engineering) ───────────────────
    AI_OPS["AI Agent Ops<br/>L09 Research Innovation<br/>+ _b_track_interfaces<br/>LLM 调用 · 记忆 · 实验研究"]

    %% ══════════════════════════════════════════════════════════════
    %% DATA FLOW EDGES — 主流数据流（含 P0 跨层数据契约标注）
    %% ══════════════════════════════════════════════════════════════

    MD_EXT -->|"RawMarketData"| L00_CONN
    ALT_EXT -->|"RawAlternativeData"| L00_CONN

    L00_CONN --> L00_NORM
    L00_NORM --> L00_QG
    L00_QG -->|"QualityGatePass"| L00_STORE
    L00_QG -->|"QualityGatePass"| L00_CACHE
    L00_STORE -->|"🔒 CTR-001<br/>NormalizedMarketData"| L02_PIPE
    L00_CACHE -->|"🔒 CTR-001<br/>NormalizedMarketData"| L02_PIPE

    L02_PIPE --> L02_BASE
    L02_BASE --> L02_FACTORS
    L02_FACTORS --> L02_EVAL
    L02_EVAL -->|"🔒 CTR-002<br/>FactorSignal"| L03_SIG
    L02_REG -.->|"注册/发现"| L02_FACTORS

    ALT_EXT -->|"SentimentRawData"| L03_SENT
    L03_SENT -->|"SentimentSignal"| L03_SIG
    L03_PRED -->|"PredictionSignal"| L03_SIG
    L03_SIG -->|"CompositeSignal"| L04_METRICS
    L03_SIG -->|"CompositeSignal"| L05_OPT

    L04_METRICS --> L04_LIMITS
    L04_LIMITS -->|"🔒 CTR-003<br/>RiskLimits"| L05_OPT
    L04_SL -.->|"StopLoss触发"| L06_OMS
    L04_MON -.->|"RiskAlert"| L08_NOTIF

    L05_BASE --> L05_STRATS
    L05_STRATS --> L05_OPT
    L05_REG -.->|"注册/发现"| L05_STRATS
    L05_OPT --> L05_REB
    L05_REB -->|"🔓 CTR-004<br/>Order"| L06_PT
    L05_BT -.->|"回测反馈"| L02_EVAL

    L06_PT -->|"PreTradeCheckPass"| L06_OMS
    L06_OMS --> L06_SOR
    L06_SOR --> L06_IFACE
    L06_IFACE --> L06_ADP
    L06_ADP -->|"Order (REST/FIX)"| BROKER_EXT
    BROKER_EXT -->|"🔒 CTR-005<br/>Fill + 🔒 CTR-006<br/>PositionSnapshot"| L06_ADP
    L06_ADP -->|"FillEvent"| L06_OMS
    L06_OMS -->|"🔒 CTR-005<br/>Fill + 🔒 CTR-006<br/>PositionSnapshot"| L07_ATTR

    L07_ATTR --> L07_REV
    L07_REV --> L07_RPT
    L07_RPT -->|"PerformanceReport"| L08_ORCH
    L07_ATTR -.->|"归因反馈"| L02_EVAL

    L08_ORCH -->|"Alert / Report"| L08_NOTIF
    L08_NOTIF -->|"通知"| FEISHU_EXT
    L08_CLI -.->|"操作者指令"| L08_ORCH

    %% ── AI Ops 横向接入 ───────────────────────────────────────────
    AI_OPS -->|"LLM推理请求"| LLM_EXT
    LLM_EXT -->|"LLM推理结果"| AI_OPS
    AI_OPS -.->|"实验因子/策略"| L02_PIPE
    AI_OPS -.->|"辅助决策"| L05_OPT
    AI_OPS -.->|"知识沉淀"| L07_RPT

    %% ── Governance 横切 ───────────────────────────────────────────
    L10 -.->|"合规校验贯穿"| L00_QG
    L10 -.->|"合规校验贯穿"| L06_PT
    L10 -.->|"审计痕迹"| L07_RPT

    %% ── Strategic 消费 ────────────────────────────────────────────
    L07_RPT -->|"绩效洞察"| L11
    L04_METRICS -->|"风险指标"| L11

