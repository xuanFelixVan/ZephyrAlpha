%%{init: {'theme': 'default', 'themeVariables': {'fontSize': '16px'}}}%%
%% TOGAF 四层架构图样板 / TOGAF Four-Layer Architecture Sample
%% 说明: 这是给人看的 TOGAF 四层架构图，展示四层之间的驱动和反向约束关系
%% 配色: 蓝(业务) / 绿(信息) / 黄(应用) / 粉(技术)

graph TD
    %% 业务架构层 / Business Architecture
    subgraph BA["业务架构 / Business Architecture"]
        BA1["利益相关者<br/>Stakeholders"]
        BA2["核心业务能力<br/>Core Capabilities"]
        BA3["业务流程<br/>Business Processes"]
        BA4["非功能需求<br/>NFRs"]
    end

    %% 信息架构层 / Information Architecture
    subgraph IA["信息架构 / Information Architecture"]
        IA1["数据资产<br/>Data Assets"]
        IA2["数据模型<br/>Data Models"]
        IA3["数据流<br/>Data Flows"]
        IA4["全景图数据库<br/>depgraph.db"]
    end

    %% 应用架构层 / Application Architecture
    subgraph AA["应用架构 / Application Architecture"]
        AA1["43个功能域<br/>43 Domains"]
        AA2["模块清单<br/>Module List"]
        AA3["依赖关系<br/>Dependencies"]
        AA4["集成拓扑<br/>Integration Topology"]
    end

    %% 技术架构层 / Technology Architecture
    subgraph TA["技术架构 / Technology Architecture"]
        TA1["Python 3.11+<br/>技术栈"]
        TA2["SQLite WAL<br/>数据库"]
        TA3["ChromaDB<br/>向量数据库"]
        TA4["Cursor + Trae<br/>AI IDE"]
    end

    %% 驱动关系（向下驱动）
    BA -->|驱动| IA
    IA -->|驱动| AA
    AA -->|驱动| TA

    %% 反向约束（向上约束）
    TA -.->|约束| AA
    AA -.->|约束| IA
    IA -.->|约束| BA

    %% 样式 / Styling
    classDef business fill:#bbdefb,stroke:#0d47a1,stroke-width:2px,color:#000
    classDef information fill:#c8e6c9,stroke:#1b5e20,stroke-width:2px,color:#000
    classDef application fill:#fff9c4,stroke:#f57f17,stroke-width:2px,color:#000
    classDef technology fill:#f8bbd0,stroke:#880e4f,stroke-width:2px,color:#000

    class BA1,BA2,BA3,BA4 business
    class IA1,IA2,IA3,IA4 information
    class AA1,AA2,AA3,AA4 application
    class TA1,TA2,TA3,TA4 technology
