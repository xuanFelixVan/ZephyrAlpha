%% 决策层详情 — 10 层 L0-L6 + build_status 颜色 + 节点类型归属
%% 真源: architecture_model/domain/decision_graph_model.yaml
flowchart TB
    %% ===== L0-L6 层级流 =====
    L0["L0 数据接入与预处理层<br/>━━━━━━━━━━━━━━━━━━<br/>频率: tick<br/>成熟度: production<br/>状态: ★ stable<br/>产出: tick_data / ohlc_bar / factor_input_data<br/>━━━━━━━━━━━━━━━━━━<br/>数据源: miniQMT + iFind + tushare + 另类数据"]
    L1["L1 因子计算层<br/>━━━━━━━━━━━━━━━━━━<br/>频率: daily<br/>成熟度: production<br/>状态: ★ stable<br/>产出: factor_value（带 PIT 合规标记）<br/>━━━━━━━━━━━━━━━━━━<br/>模式: 盘前全量 / 盘中增量双模"]
    L2A["L2A 信号层<br/>━━━━━━━━━━━<br/>频率: daily<br/>成熟度: design<br/>状态: ○ planned<br/>产出: signal<br/>━━━━━━━━━━━<br/>节点: signal, sell_decision<br/>契约: Insight"]
    L2B["L2B 主力行为层<br/>━━━━━━━━━━━<br/>频率: daily<br/>成熟度: design<br/>状态: ○ planned<br/>产出: main_force_signal<br/>━━━━━━━━━━━<br/>六阶段识别 + 庄家专项"]
    L2C["L2C 大盘预测层<br/>━━━━━━━━━━━<br/>频率: daily<br/>成熟度: design<br/>状态: ○ planned<br/>产出: market_state_prediction<br/>━━━━━━━━━━━<br/>3×3矩阵 + 体制转换检测"]
    L2D["L2D 因果推演层<br/>━━━━━━━━━━━<br/>频率: daily<br/>成熟度: design<br/>状态: ○ planned<br/>产出: causal_inference_result<br/>━━━━━━━━━━━<br/>GNN + Causal ML"]
    L3["L3 策略组合层<br/>━━━━━━━━━━━━━━━━━━<br/>频率: daily<br/>成熟度: design<br/>状态: ○ planned<br/>产出: portfolio_target<br/>━━━━━━━━━━━━━━━━━━<br/>节点: portfolio_target, order<br/>契约: PortfolioTarget"]
    L4["L4 风控层<br/>━━━━━━━━━━━━━━━━━━<br/>频率: realtime<br/>成熟度: production<br/>状态: ★ stable<br/>产出: risk_check<br/>━━━━━━━━━━━━━━━━━━<br/>节点: risk_check, compliance_check<br/>特殊: veto 一票否决"]
    L5["L5 学习层<br/>━━━━━━━━━━━<br/>频率: weekly<br/>成熟度: design<br/>状态: ○ planned<br/>产出: learning_feedback<br/>━━━━━━━━━━━<br/>7阶段学习流水线"]
    L6["L6 自评估层<br/>━━━━━━━━━━━<br/>频率: weekly<br/>成熟度: design<br/>状态: ○ planned<br/>产出: self_evaluation<br/>━━━━━━━━━━━<br/>LLM Judge + VeNRA"]

    %% 层间流向
    L0 -->|informing| L1
    L1 -->|informing| L2A
    L1 -->|informing| L2B
    L1 -->|informing| L2C
    L1 -->|informing| L2D
    L2A -->|informing| L3
    L2B -->|informing| L3
    L2C -->|informing| L3
    L2D -->|informing| L3
    L3 -->|triggering| L4
    L4 -->|approving| L3
    L4 -.->|反馈闭环| L5
    L5 -.->|反馈闭环| L6
    L6 -.->|反馈闭环| L2A

    %% 样式：build_status 颜色编码
    classDef stable fill:#c8e6c9,stroke:#2e7d32,stroke-width:3px,color:#1b5e20
    classDef planned fill:#fff9c4,stroke:#f57f17,stroke-width:2px,color:#e65100
    classDef risk fill:#ffcdd2,stroke:#c62828,stroke-width:3px,color:#b71c1c

    class L0,L1 stable
    class L2A,L2B,L2C,L2D,L3,L5,L6 planned
    class L4 risk

    %% 图例
    subgraph LEGEND["图例"]
        L_ST["★ stable = 生产就绪"]:::stable
        L_PL["○ planned = 已规划未实现"]:::planned
        L_RK["L4 风控层（veto 一票否决）"]:::risk
    end
