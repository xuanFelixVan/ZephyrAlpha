%% Data Flow Diagram — ZephyrAlpha 2.0 Core Pipeline
%% 升级记录：2026-05-04 — 从旧编号体系(DS/RF/ML/SP/EX/RP)迁移到14层体系(L00-L07)
%% 显式标注 P0 跨层数据契约 CTR-001~CTR-006 作为架构承重墙
%% 契约真源：architecture-model/contracts/cross-layer-contracts.yaml
%% 图例：🔒 = frozen (不可变契约)  |  🔓 = mutable (可变契约，状态机)
flowchart TD
    subgraph External["外部系统 External Systems"]
        MD["行情数据源<br/>Market Data Provider"]
        BK["券商 API<br/>Broker API"]
    end

    subgraph L00_Layer["L00 · Data Source / 数据源"]
        L00["l00_data_source/<br/>Ingestion · Standardization · Quality Gating<br/>接入 · 标准化 · 质量门禁"]
    end

    subgraph L02_Layer["L02 · Alpha Factor / Alpha 因子"]
        L02["l02_alpha_factor/<br/>Factor Calculation · Evaluation · Engineering<br/>因子计算 · 评估 · 工程"]
    end

    subgraph L03_Layer["L03 · Signal Generation / 信号生成"]
        L03["l03_signal_generation/<br/>Sentiment · Signal Extraction · Predictions<br/>舆情 · 信号提取 · 预测"]
    end

    subgraph L04_Layer["L04 · Risk Management / 风险管理"]
        L04["l04_risk_management/<br/>Risk Measurement · Limits · Stop-loss<br/>风险度量 · 限额 · 止损"]
    end

    subgraph L05_Layer["L05 · Portfolio Construction / 组合构建"]
        L05["l05_portfolio_construction/<br/>Weight Allocation · Optimization · Backtest<br/>权重分配 · 优化 · 回测"]
    end

    subgraph L06_Layer["L06 · Trade Execution / 交易执行"]
        L06["l06_trade_execution/<br/>OMS · SOR · Order Execution · Pre-trade Risk<br/>OMS · SOR · 委托执行 · 执行前风控"]
    end

    subgraph L07_Layer["L07 · Post-Trade Analytics / 交易后分析"]
        L07["l07_post_trade_analytics/<br/>Performance Attribution · Review · Reporting<br/>绩效归因 · 复盘 · 报告"]
    end

    subgraph L11_Layer["L11 · ML Platform / 机器学习平台"]
        L11["l11_ml_platform/<br/>Model Training · Registry · Inference<br/>模型训练 · 注册 · 推理"]
    end

    subgraph L12_Layer["L12 · System Telemetry / 系统遥测"]
        L12["l12_system_telemetry/<br/>Structured Metrics · Observability<br/>结构化指标 · 可观测性"]
    end

    %% External → L00
    MD -->|"REST/WebSocket<br/>原始行情数据"| L00

    %% L00 → L02: CTR-001 NormalizedMarketData (frozen)
    L00 -->|"🔒 CTR-001<br/>NormalizedMarketData<br/>[frozen]"| L02

    %% L02 → L03: CTR-002 FactorSignal (frozen)
    L02 -->|"🔒 CTR-002<br/>FactorSignal<br/>[frozen]"| L03

    %% L02 → L04: CTR-002 FactorSignal (frozen)
    L02 -->|"🔒 CTR-002<br/>FactorSignal<br/>[frozen]"| L04

    %% L02 → L05: CTR-002 FactorSignal (frozen)
    L02 -->|"🔒 CTR-002<br/>FactorSignal<br/>[frozen]"| L05

    %% L03 → L05: 信号输入（非 P0 契约，内部调用）
    L03 -->|"Signal<br/>预测信号"| L05

    %% L04 → L05: CTR-003 RiskLimits (frozen)
    L04 -->|"🔒 CTR-003<br/>RiskLimits<br/>[frozen]"| L05

    %% L05 → L06: CTR-004 Order (mutable)
    L05 -->|"🔓 CTR-004<br/>Order<br/>[mutable / 状态机]"| L06

    %% L06 → BK: 委托发送
    L06 -->|"REST/FIX<br/>委托发送"| BK
    BK -->|"成交回报"| L06

    %% L06 → L07: CTR-005 Fill (frozen)
    L06 -->|"🔒 CTR-005<br/>Fill<br/>[frozen]"| L07

    %% L06 → L04: CTR-006 PositionSnapshot (frozen) — 风控监控
    L06 -->|"🔒 CTR-006<br/>PositionSnapshot<br/>[frozen]"| L04

    %% L07 → L04: CTR-006 PositionSnapshot (frozen) — 复盘后风险更新
    L07 -->|"🔒 CTR-006<br/>PositionSnapshot<br/>[frozen]"| L04

    %% L07 → L11: CTR-006 PositionSnapshot (frozen) — 战略决策
    L07 -->|"🔒 CTR-006<br/>PositionSnapshot<br/>[frozen]"| L11

    %% L07 → L12: 绩效指标上报
    L07 -->|"PnL / Risk Metrics<br/>绩效与风险指标"| L12

    %% L11 → L02: 模型预测反馈
    L11 -->|"ModelPrediction<br/>模型预测"| L02

    %% L11 → L05: 模型预测反馈
    L11 -->|"ModelPrediction<br/>模型预测"| L05

    %% L04 → L12: 风险指标上报
    L04 -->|"Risk Metrics<br/>风险指标"| L12

