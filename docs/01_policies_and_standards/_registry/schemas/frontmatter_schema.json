        ]
      },
      "then": {
        "properties": {
          "header_format": {
            "const": "B_yaml"
          }
        }
      }
    },
    {
      "description": "file_category=registry 时 header_format 必须为 B_yaml",
      "if": {
        "properties": {
          "file_category": {
            "const": "registry"
          }
        },
        "required": [
          "file_category"
        ]
      },
      "then": {
        "properties": {
          "header_format": {
            "const": "B_yaml"
          }
        }
      }
    },
    {
      "description": "file_category=doc 时 header_format 必须为 D_md",
      "if": {
        "properties": {
