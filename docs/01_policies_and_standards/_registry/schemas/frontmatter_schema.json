{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyralpha.dev/schemas/frontmatter_schema.json",
  "$comment": "自动生成自 PS-STD-001 (trae_043_meta_rule_metadata.yaml)。依赖词表：doc_type_vocabulary.yaml / rule_form_vocabulary.yaml / status_vocabulary.yaml。禁止手写——枚举变更必须先改词表再改 PS-STD-001 最后重新生成本文件。",
  "title": "ZephyrAlpha Frontmatter Schema",
  "description": "机器可读的 frontmatter 验证 schema。从 PS-STD-001 自动生成，禁止手写。枚举值使用 oneOf+const+description 模式（对标 SchemaStore 最佳实践），IDE 可对每个枚举值显示中文解释。分阶段必填闸门由 pre-commit 脚本执行（JSON Schema 无法表达条件必填）。",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string",
      "description": "模块唯一标识。格式：DOMAIN-TYPE-NNN（大写字母+连字符）。PS-STD-001 §5",
      "pattern": "^[A-Z]+(-[A-Z]+)?-[A-Z]+-\\d{3,4}$"
    },
    "title": {
      "type": "string",
      "description": "文档中文标题",
      "minLength": 1
    },
    "doc_type": {
      "description": "文档品种——01_policies_and_standards/ 目录下 9 种。PS-STD-001 §3.2.1",
      "oneOf": [
        {
          "const": "policy"
        },
        {
          "const": "register"
        },
        {
          "const": "index"
        },
        {
          "const": "template"
        },
        {
          "const": "vocabulary"
        },
        {
          "const": "blueprint"
        },
        {
          "const": "audit_report"
        },
        {
          "const": "architecture_view"
        },
        {
          "const": "gate"
        }
      ]
    },
    "status": {
      "description": "文档状态——DocStatus 仅 3 值（archived 已否决）。PS-STD-001 §4.1",
      "oneOf": [
        {
          "const": "draft",
          "description": "草稿，正在编写中"
        },
        {
          "const": "active",
          "description": "已生效，当前有效"
        },
        {
          "const": "deprecated",
          "description": "已废弃，有替代品或已合并（需填写 superseded_by）"
        }
      ]
    },
    "version": {
      "type": "string",
      "description": "语义化版本 X.Y.Z",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "layer": {
      "description": "架构层归属——4 值（L0_infrastructure/L1_foundation/L2_domain/L3_application, canonical SSoT: layer_vocabulary.yaml）",
      "oneOf": [
        {
          "const": "L0_infrastructure",
          "description": "L0 基础设施层——平台基础设施、共享服务、数据接入等底层支撑"
        },
        {
          "const": "L1_foundation",
          "description": "L1 基础能力层——横切关注点、治理框架、契约定义等中层基础"
        },
        {
          "const": "L2_domain",
          "description": "L2 业务域层——具体业务域实现（数据/因子/信号/风控/组合/执行/报告等）"
        },
        {
          "const": "L3_application",
          "description": "L3 应用层——应用入口、用户界面、端到端集成等顶层应用"
        }
      ]
    },
    "owner": {
      "type": "string",
      "description": "文档负责人",
      "default": "ZephyrAlpha-Owner"
    },
    "classification": {
      "description": "机密等级——三分法（public / internal / confidential）。PS-STD-001 §4.6",
      "oneOf": [
        {
          "const": "public",
          "description": "公开——可对外分享，无敏感信息"
        },
        {
          "const": "internal",
          "description": "内部——仅项目成员可见"
        },
        {
          "const": "confidential",
          "description": "保密——仅团队内部使用"
        }
      ]
    },
    "language": {
      "description": "主语言",
      "oneOf": [
        {
          "const": "zh",
          "description": "中文"
        },
        {
          "const": "en",
          "description": "英文"
        },
        {
          "const": "zh_en",
          "description": "中英双语"
        }
      ]
    },
    "created_by": {
      "description": "创建者类型",
      "oneOf": [
        {
          "const": "human",
          "description": "人类独立创建"
        },
        {
          "const": "agent",
          "description": "AI Agent 独立生成"
        },
        {
          "const": "human_plus_agent",
          "description": "人机协作创建"
        }
      ]
    },
    "date": {
      "type": "string",
      "description": "最后修改日期 YYYY-MM-DD",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "valid_from": {
      "type": "string",
      "description": "生效日期 YYYY-MM-DD",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "ttl": {
      "description": "保留期。PS-STD-001 §6（2 值二元，v2.0.0）",
      "oneOf": [
        {
          "const": "permanent",
          "description": "永久保留——项目存续期内不删除"
        },
        {
          "const": "task_bound",
          "description": "任务绑定——任务完成即可清理。过程性文档默认落 docs/_working/"
        }
      ]
    },
    "summary": {
      "type": "string",
      "description": "一句话摘要——AI 检索锚点",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "description": "自由标签，补充 doc_type 细分类",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rule_form": {
      "description": "规则表达形式。PS-STD-001 §2.5（4 值）",
      "oneOf": [
        {
          "const": "declarative",
          "description": "声明式——定义'是什么'，不定义'怎么做'"
        },
        {
          "const": "procedural",
          "description": "过程式——定义操作步骤和流程"
        },
        {
          "const": "data",
          "description": "数据式——结构化数据清单/注册表"
        },
        {
          "const": "structural",
          "description": "结构式——定义格式/骨架/模板"
        }
      ]
    },
    "scope": {
      "description": "规则作用范围。PS-STD-001 §2.5（4 值）",
      "oneOf": [
        {
          "const": "global",
          "description": "全局——适用整个项目"
        },
        {
          "const": "domain",
          "description": "领域级——适用特定业务域"
        },
        {
          "const": "layer",
          "description": "层级——适用特定架构层"
        },
        {
          "const": "module",
          "description": "模块级——适用特定功能模块"
        }
      ]
    },
    "stability": {
      "description": "规则稳定性。PS-STD-001 §2.5（4 值）",
      "oneOf": [
        {
          "const": "frozen",
          "description": "冻结——不可变更，AI 必须原封不动遵守"
        },
        {
          "const": "stable",
          "description": "稳定——通过变更门控可修改"
        },
        {
          "const": "evolving",
          "description": "演进中——可频繁修改，但需记录原因"
        },
        {
          "const": "volatile",
          "description": "易变——AI 可自主调整，无需审批"
        }
      ]
    },
    "verifiability": {
      "description": "规则可验证性。PS-STD-001 §2.5（3 值）",
      "oneOf": [
        {
          "const": "automated",
          "description": "自动化验证——CI/脚本可 100% 验证"
        },
        {
          "const": "manual",
          "description": "人工验证——需人类判断"
        },
        {
          "const": "inspection",
          "description": "审查验证——需资深人员审查"
        }
      ]
    },
    "depends_on": {
      "description": "结构化依赖声明。兼容 string[]（旧版）和 map[]（新版）。PS-STD-001 §2.1",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "旧版格式：module_id 字符串列表"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "description": "依赖的 module_id"
              },
              "at": {
                "type": "string",
                "description": "引用的具体章节（如 §3.2.1）"
              },
              "why": {
                "type": "string",
                "description": "为什么依赖此项"
              }
            },
            "required": [
              "target",
              "at"
            ]
          },
          "description": "新版格式：结构化依赖对象列表"
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "description": "取代了哪些文件",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "version",
          "reason"
        ]
      }
    },
    "superseded_by": {
      "type": "string",
      "description": "被哪个文件取代。deprecated 时必填，有替代品填路径，无替代品填 N/A"
    },
    "derived_from": {
      "type": "array",
      "description": "横向知识来源。PS-STD-001 §10.17",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "relationship": {
            "description": "知识关系类型",
            "oneOf": [
              {
                "const": "synthesized",
                "description": "综合——从此来源提炼/归纳"
              },
              {
                "const": "referenced",
                "description": "引用——直接引用此来源"
              },
              {
                "const": "transformed",
                "description": "转换——从此来源改写得来"
              }
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "path",
          "relationship"
        ]
      }
    },
    "related_kb_ref": {
      "type": "array",
      "description": "关联的 KB 决策记录编号",
      "items": {
        "type": "string"
      }
    },
    "safety_level": {
      "description": "安全风险等级。PS-STD-001 §10.10",
      "oneOf": [
        {
          "const": "H",
          "description": "高风险——涉及资金/安全关键路径"
        },
        {
          "const": "M",
          "description": "中风险——影响系统稳定性"
        },
        {
          "const": "L",
          "description": "低风险——辅助功能"
        }
      ]
    },
    "evolution_policy": {
      "description": "文件演进策略。PS-STD-001 §10.11",
      "oneOf": [
        {
          "const": "frozen",
          "description": "冻结——不可演进，等效删除"
        },
        {
          "const": "extendable",
          "description": "可扩展——可新增内容，不删改已有内容"
        },
        {
          "const": "rewritable",
          "description": "可重写——可增删改任意内容"
        }
      ]
    },
    "ai_autonomy": {
      "description": "AI 自治权限。PS-STD-001 §4.5（全小写，3 值）",
      "oneOf": [
        {
          "const": "immutable_core",
          "description": "不可变核心——AI 完全不能改，只能读"
        },
        {
          "const": "human_gated",
          "description": "人工闸门——AI 可提议修改，需 Owner 批准后才生效"
        },
        {
          "const": "ai_modifiable",
          "description": "AI 可修改——AI 可直接编辑，无需审批"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "description": "溯源信息。PS-STD-001 §10.3",
      "properties": {
        "origin_drafts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            }
          }
        },
        "audit_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "auditor": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "verdict": {
                "description": "审计结论",
                "oneOf": [
                  {
                    "const": "pass",
                    "description": "通过"
                  },
                  {
                    "const": "fail",
                    "description": "不通过"
                  },
                  {
                    "const": "conditional",
                    "description": "有条件通过"
                  }
                ]
              }
            }
          }
        },
        "arbitration": {
          "type": "object",
          "properties": {
            "arbiter": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "decision": {
              "type": "string"
            }
          }
        }
      }
    },
    "author_agent": {
      "type": "string",
      "description": "创作代理——编辑器/产品名。PS-STD-001 §10.5",
      "examples": [
        "Cursor-Premium",
        "Trae-Free",
        "Claude-API"
      ]
    },
    "governance_family": {
      "description": "治理系统家族。PS-STD-001 §10.7",
      "oneOf": [
        {
          "const": "A",
          "description": "家族 A——策略/标准类规则"
        },
        {
          "const": "B",
          "description": "家族 B——操作性流程类规则"
        },
        {
          "const": "C",
          "description": "家族 C——Schema/契约类规则"
        },
        {
          "const": "D",
          "description": "家族 D——模板/骨架类规则"
        }
      ]
    },
    "ai_capability_slot": {
      "description": "AI 能力槽位。PS-STD-001 §10.7",
      "oneOf": [
        {
          "const": "planned",
          "description": "已规划——尚未实现"
        },
        {
          "const": "reserved",
          "description": "已预留——架构中留位，待开发"
        },
        {
          "const": "active",
          "description": "已激活——当前在用"
        },
        {
          "const": "none",
          "description": "无——不需要 AI 能力槽位"
        }
      ]
    },
    "ai_autonomy_level_planned": {
      "description": "规划的 AI 自治等级。PS-STD-001 §10.7",
      "oneOf": [
        {
          "const": "l0",
          "description": "L0 无自治——AI 仅辅助建议，不执行任何操作"
        },
        {
          "const": "l1",
          "description": "L1 低自治——AI 可执行读操作，写操作需审批"
        },
        {
          "const": "l2",
          "description": "L2 中自治——AI 可读写，关键操作需审批"
        },
        {
          "const": "l3",
          "description": "L3 高自治——AI 全权自主操作"
        }
      ]
    },
    "ai_employee_count_planned": {
      "type": "integer",
      "description": "规划的 AI 员工数量",
      "minimum": 0,
      "maximum": 10
    },
    "blueprint_refs": {
      "type": "array",
      "description": "施工图引用的蓝图列表。PS-STD-001 §10.12",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "description": "蓝图状态",
            "oneOf": [
              {
                "const": "active",
                "description": "当前有效"
              },
              {
                "const": "draft",
                "description": "草稿中"
              },
              {
                "const": "deprecated",
                "description": "已废弃"
              }
            ]
          },
          "decisions_used": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "path",
          "status"
        ]
      }
    },
    "compliance_tags": {
      "type": "array",
      "description": "合规标签。PS-STD-001 §10.13",
      "items": {
        "oneOf": [
          {
            "const": "SR-11-7",
            "description": "中国证监会《证券期货业数据安全管理与保护指引》"
          },
          {
            "const": "EU-AI-Act-Art12",
            "description": "欧盟 AI 法案第 12 条——记录保存"
          },
          {
            "const": "EU-AI-Act-Art14",
            "description": "欧盟 AI 法案第 14 条——人工监督"
          },
          {
            "const": "GDPR-Art22",
            "description": "GDPR 第 22 条——自动化决策的限制"
          },
          {
            "const": "PCI-DSS",
            "description": "支付卡行业数据安全标准"
          },
          {
            "const": "MiFID-II",
            "description": "欧盟金融工具市场指令 II"
          }
        ]
      },
      "uniqueItems": true
    },
    "human_override": {
      "type": "object",
      "description": "人工干预记录。PS-STD-001 §10.14",
      "properties": {
        "operator_id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string"
        },
        "original_action": {
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "date",
        "reason"
      ]
    },
    "last_reviewed_by": {
      "type": "object",
      "description": "最后审核人/模型。PS-STD-001 §10.15",
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "model_used": {
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "date"
      ]
    },
    "review_status": {
      "description": "审核状态。PS-STD-001 §10.16",
      "oneOf": [
        {
          "const": "unreviewed",
          "description": "未审核"
        },
        {
          "const": "reviewed",
          "description": "已审核"
        },
        {
          "const": "approved",
          "description": "已批准"
        },
        {
          "const": "rejected",
          "description": "已驳回"
        }
      ]
    },
    "category": {
      "description": "知识条目内容类型。PS-STD-001 §9.1（10 值）",
      "oneOf": [
        {
          "const": "blueprint_decision",
          "description": "蓝图决策——架构级别的设计选择与论证"
        },
        {
          "const": "strategy",
          "description": "策略——交易/投资策略定义"
        },
        {
          "const": "factor",
          "description": "因子——Alpha 因子定义与回测"
        },
        {
          "const": "best_practice",
          "description": "最佳实践——经验总结与编码规范"
        },
        {
          "const": "lesson_learned",
          "description": "经验教训——错误记录与改进措施"
        },
        {
          "const": "architecture",
          "description": "架构——系统设计文档"
        },
        {
          "const": "risk_control",
          "description": "风控——风险规则与熔断机制"
        },
        {
          "const": "data_governance",
          "description": "数据治理——数据标准与质量规则"
        },
        {
          "const": "operations",
          "description": "运维——部署/监控/告警"
        },
        {
          "const": "compliance",
          "description": "合规——监管法律法规映射"
        }
      ]
    },
    "domain": {
      "description": "知识条目业务领域。PS-STD-001 §9.2（10 值）",
      "oneOf": [
        {
          "const": "data",
          "description": "数据——数据源/清洗/存储/管道"
        },
        {
          "const": "feature",
          "description": "特征——特征工程/因子计算"
        },
        {
          "const": "model",
          "description": "模型——ML 训练/推理/部署"
        },
        {
          "const": "signal",
          "description": "信号——信号生成/合成/分發"
        },
        {
          "const": "execution",
          "description": "执行——订单/交易/成交"
        },
        {
          "const": "risk",
          "description": "风险——风控/限额/熔斷"
        },
        {
          "const": "portfolio",
          "description": "组合——持仓/优化/再平衡"
        },
        {
          "const": "reporting",
          "description": "报告——绩效/归因/监管报告"
        },
        {
          "const": "infrastructure",
          "description": "基础设施——服务器/网络/存储"
        },
        {
          "const": "other",
          "description": "其他——不属于上述任何领域"
        }
      ]
    },
    "header_format": {
      "description": "文件表头格式——7 值。GOV-ENG-002 §9.4 定义",
      "oneOf": [
        {
          "const": "A_full",
          "description": ".py 十字段完整版——code, script 文件"
        },
        {
          "const": "A_test",
          "description": ".py 六字段简化版——test 文件"
        },
        {
          "const": "B_yaml",
          "description": "YAML 5 字段注释块——gate, registry, contract(yaml), config, data"
        },
        {
          "const": "C_json",
          "description": "JSON _meta 字段——contract(json), schema(json)"
        },
        {
          "const": "D_md",
          "description": ".md YAML frontmatter——doc 文件"
        },
        {
          "const": "E_shell",
          "description": "Shell/Mermaid 注释头部——infra 文件"
        },
        {
          "const": "exempt",
          "description": "豁免——不需要表头"
        }
      ]
    },
    "file_category": {
      "description": "文件治理分类——10 值。GOV-ENG-002 §9.5 定义。决定文件应使用哪种 header_format",
      "oneOf": [
        {
          "const": "code",
          "description": "生产代码——src/zephyr/**/*.py"
        },
        {
          "const": "script",
          "description": "治理/工具脚本——scripts/**/*.py"
        },
        {
          "const": "gate",
          "description": "门禁定义——src/zephyr/gov_enforcement/rule_enforcement/*.yaml"
        },
        {
          "const": "registry",
          "description": "注册表——*_registry.yaml, *manifest.yaml"
        },
        {
          "const": "contract",
          "description": "契约定义——shared/contracts/*.py, contracts/*.yaml"
        },
        {
          "const": "config",
          "description": "配置文件——config/*.yaml"
        },
        {
          "const": "data",
          "description": "运行时数据——data/**/*.yaml"
        },
        {
          "const": "doc",
          "description": "文档——docs/**/*.md"
        },
        {
          "const": "test",
          "description": "测试——tests/**/*.py"
        },
        {
          "const": "infra",
          "description": "基础设施——.sh, .ps1, .mmd"
        }
      ]
    }
  },
  "required": [
    "module_id",
    "title",
    "doc_type",
    "status",
    "version",
    "date",
    "owner"
  ],
  "additionalProperties": {
    "not": {},
    "pattern": "^custom_"
  },
  "allOf": [
    {
      "description": "deprecated 状态时 superseded_by 必填",
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "superseded_by"
        ]
      }
    },
    {
      "description": "policy 类型的 rule_form 为 declarative 或 procedural",
      "if": {
        "properties": {
          "doc_type": {
            "const": "policy"
          }
        },
        "required": [
          "doc_type"
        ]
      },
      "then": {
        "properties": {
          "rule_form": {
            "enum": [
              "declarative",
              "procedural"
            ]
          }
        }
      }
    },
    {
      "description": "register 类型的 rule_form 必须为 data",
      "if": {
        "properties": {
          "doc_type": {
            "const": "register"
          }
        },
        "required": [
          "doc_type"
        ]
      },
      "then": {
        "properties": {
          "rule_form": {
            "const": "data"
          }
        }
      }
    },
    {
      "description": "index 类型的 rule_form 必须为 declarative",
      "if": {
        "properties": {
          "doc_type": {
            "const": "index"
          }
        },
        "required": [
          "doc_type"
        ]
      },
      "then": {
        "properties": {
          "rule_form": {
            "const": "declarative"
          }
        }
      }
    },
    {
      "description": "template 类型的 rule_form 必须为 structural",
      "if": {
        "properties": {
          "doc_type": {
            "const": "template"
          }
        },
        "required": [
          "doc_type"
        ]
      },
      "then": {
        "properties": {
          "rule_form": {
            "const": "structural"
          }
        }
      }
    },
    {
      "description": "vocabulary 类型的 rule_form 必须为 data",
      "if": {
        "properties": {
          "doc_type": {
            "const": "vocabulary"
          }
        },
        "required": [
          "doc_type"
        ]
      },
      "then": {
        "properties": {
          "rule_form": {
            "const": "data"
          }
        }
      }
    },
    {
      "description": "blueprint 类型的 rule_form 必须为 declarative",
      "if": {
        "properties": {
          "doc_type": {
            "const": "blueprint"
          }
        },
        "required": [
          "doc_type"
        ]
      },
      "then": {
        "properties": {
          "rule_form": {
            "const": "declarative"
          }
        }
      }
    },
    {
      "description": "audit_report 类型的 rule_form 必须为 data",
      "if": {
        "properties": {
          "doc_type": {
            "const": "audit_report"
          }
        },
        "required": [
          "doc_type"
        ]
      },
      "then": {
        "properties": {
          "rule_form": {
            "const": "data"
          }
        }
      }
    },
    {
      "description": "architecture_view 类型的 rule_form 必须为 declarative",
      "if": {
        "properties": {
          "doc_type": {
            "const": "architecture_view"
          }
        },
        "required": [
          "doc_type"
        ]
      },
      "then": {
        "properties": {
          "rule_form": {
            "const": "declarative"
          }
        }
      }
    },
    {
      "description": "gate 类型的 rule_form 必须为 declarative",
      "if": {
        "properties": {
          "doc_type": {
            "const": "gate"
          }
        },
        "required": [
          "doc_type"
        ]
      },
      "then": {
        "properties": {
          "rule_form": {
            "const": "declarative"
          }
        }
      }
    },
    {
      "description": "stability=frozen 时 ai_autonomy 必须为 immutable_core",
      "if": {
        "properties": {
          "stability": {
            "const": "frozen"
          }
        },
        "required": [
          "stability"
        ]
      },
      "then": {
        "properties": {
          "ai_autonomy": {
            "const": "immutable_core"
          }
        }
      }
    },
    {
      "description": "stability=frozen 时 evolution_policy 必须为 frozen（语义一致性约束）",
      "if": {
        "properties": {
          "stability": {
            "const": "frozen"
          }
        },
        "required": [
          "stability"
        ]
      },
      "then": {
        "properties": {
          "evolution_policy": {
            "const": "frozen"
          }
        }
      }
    },
    {
      "description": "stability=volatile 时 ai_autonomy 不能是 immutable_core",
      "if": {
        "properties": {
          "stability": {
            "const": "volatile"
          }
        },
        "required": [
          "stability"
        ]
      },
      "then": {
        "properties": {
          "ai_autonomy": {
            "not": {
              "const": "immutable_core"
            }
          }
        }
      }
    },
    {
      "description": "file_category=code 时 header_format 必须为 A_full",
      "if": {
        "properties": {
