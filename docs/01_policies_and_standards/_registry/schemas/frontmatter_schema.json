            "const": "script"
          }
        },
        "required": [
          "file_category"
        ]
      },
      "then": {
        "properties": {
          "header_format": {
            "const": "A_full"
          }
        }
      }
    },
    {
      "description": "file_category=test 时 header_format 必须为 A_test",
      "if": {
        "properties": {
          "file_category": {
            "const": "test"
          }
        },
        "required": [
          "file_category"
        ]
      },
      "then": {
        "properties": {
          "header_format": {
            "const": "A_test"
          }
        }
      }
    },
    {
      "description": "file_category=gate 时 header_format 必须为 B_yaml",
      "if": {
