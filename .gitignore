# ============================================
# ZephyrAlpha v2.0 .gitignore
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Environments
.env
.env.local
.env.*.local
.env.qmt
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.secrets/
*.key
*.pem
*.cert

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# SQLite
*.db
*.db-wal
*.db-shm
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Project-specific runtime artifacts
.runtime/
.trae_cache/

# AI file lock registry (runtime state, not config)
.ailocks/

# AI Generated files
*.generated.md
*.generated.json
*.scan_result.json
*.tmp.md
*.tmp.json

# Root scratch from ad-hoc YAML/tooling (ZERO-RESIDUE; must not be committed)
/_temp*.yaml
/_temp*.py

# Temp and backup
*.bak
*.tmp
*.temp
*.log
*.log.*

# Legacy tree (DO NOT check in)
_DO_NOT_USE_old_tree/

# Non-project auxiliary directories
临时工作区/
模块候选池/

# Migration artifact directories
_backup_
_migration_conflict_backup/

# Governance JSONL reports
scripts/reports/*.jsonl

