# ============================================
# ZephyrAlpha v2.0 .gitignore
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
# Python setuptools 构建产物（下划线变体，如 src/zephyralpha.egg_info/）
# 治本：原 *.egg-info/(连字符) 不匹配实际目录名 egg_info/(下划线)，导致构建产物被跟踪
*.egg_info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Electron 桌面壳（tools/desktop/）——依赖与锁文件不入库（版本由 package.json 声明）
node_modules/
tools/desktop/package-lock.json

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
# .pytest_tmp/ — AI 会话临时 pytest 工作区（原子操作脚本暂存，ARCH-TTL-DOC-001 治本 2026-07-17）
# 病根：AI 用 .pytest_tmp/ 存放跨进程原子操作脚本（如 _atomic2.py / _verify_fixes.py），
# 避免主工作区被并发 AI 覆盖。原 .gitignore 漏忽略，导致 git status 噪音 + 误入库风险。
.pytest_tmp/

# Translations
*.mo
*.pot

# Environments
.env
.env.local
.env.*.local
.env.qmt
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.secrets/
*.key
*.pem
*.cert

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# SQLite
*.db
*.db-wal
*.db-shm
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Project-specific runtime artifacts
.runtime/
.trae_cache/

# AI draft worktree directory (session_worktree runtime, must not be tracked)
# 用 sess-*/ 只忽略 worktree 目录，不忽略 gitlink 文件（便于清理误入库的 gitlink）
.aidrafts/sess-*/

# AI worktree pool directory (ARCH-GIT-CALL-BUDGET P3.3, 2026-07-19)
# Pre-created worktrees for lease-on-session-start; runtime, must not be tracked.
.aidrafts_pool/

# AI session worktree directory（scripts/session_worktree.py 第二代机制，#ARCH-AICOLLAB-001）
# 会话物理隔离工作区，运行时目录不得入库；worktree 内含 config/.env.postgres 凭据副本（环境三件套），
# 不入库同时堵住 SECRET 扩散面（#ARCH-WORKTREE-ENV-001）
.worktrees/

# AI file lock registry (runtime state, not config)
.ailocks/

# AI Generated files
*.generated.md
*.generated.json
*.scan_result.json
*.tmp.md
*.tmp.json

# Scratch from ad-hoc YAML/tooling (ZERO-RESIDUE; 无前导/匹配所有目录，治本 2026-06-29)
_temp*.yaml
_temp*.py

# Temp and backup
*.bak
*.bak.*
*.baseline
*.baseline_content
*.tmp
*.temp
*.log
*.log.*

# Legacy tree (DO NOT check in)
_DO_NOT_USE_old_tree/

# Non-project auxiliary directories
临时工作区/
模块候选池/

