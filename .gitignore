# ============================================
# ZephyrAlpha v2.0 .gitignore
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
# Python setuptools 构建产物（下划线变体，如 src/zephyralpha.egg_info/）
# 治本：原 *.egg-info/(连字符) 不匹配实际目录名 egg_info/(下划线)，导致构建产物被跟踪
*.egg_info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
# .pytest_tmp/ — AI 会话临时 pytest 工作区（原子操作脚本暂存，ARCH-TTL-DOC-001 治本 2026-07-17）
# 病根：AI 用 .pytest_tmp/ 存放跨进程原子操作脚本（如 _atomic2.py / _verify_fixes.py），
# 避免主工作区被并发 AI 覆盖。原 .gitignore 漏忽略，导致 git status 噪音 + 误入库风险。
.pytest_tmp/

# Translations
*.mo
*.pot

# Environments
.env
.env.local
.env.*.local
.env.qmt
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.secrets/
*.key
*.pem
*.cert

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# SQLite
*.db
*.db-wal
*.db-shm
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Project-specific runtime artifacts
.runtime/
.trae_cache/

# AI draft worktree directory (session_worktree runtime, must not be tracked)
# 用 sess-*/ 只忽略 worktree 目录，不忽略 gitlink 文件（便于清理误入库的 gitlink）
.aidrafts/sess-*/

# AI worktree pool directory (ARCH-GIT-CALL-BUDGET P3.3, 2026-07-19)
# Pre-created worktrees for lease-on-session-start; runtime, must not be tracked.
.aidrafts_pool/

# AI file lock registry (runtime state, not config)
.ailocks/

# AI Generated files
*.generated.md
*.generated.json
*.scan_result.json
*.tmp.md
*.tmp.json

# Scratch from ad-hoc YAML/tooling (ZERO-RESIDUE; 无前导/匹配所有目录，治本 2026-06-29)
_temp*.yaml
_temp*.py

# Temp and backup
*.bak
*.bak.*
*.baseline
*.baseline_content
*.tmp
*.temp
*.log
*.log.*

# Legacy tree (DO NOT check in)
_DO_NOT_USE_old_tree/

# Non-project auxiliary directories
临时工作区/
模块候选池/

# Migration artifact directories
_backup_
_migration_conflict_backup/

# Governance JSONL reports
scripts/reports/*.jsonl

# Drift detector runtime data (only .gitkeep is tracked)
data/drift_baselines/*
!data/drift_baselines/.gitkeep
data/drift_checkpoints/*
!data/drift_checkpoints/.gitkeep

# Health snapshots runtime data (only .gitkeep is tracked)
src/zephyr/data/health_snapshots/*
!src/zephyr/data/health_snapshots/.gitkeep

# P6b 治本（2026-06-30）：src/zephyr/data/ 下运行时产物 untrack
# 代码真源为 root data/（data/audit_logs/、data/telemetry/），src/zephyr/data/ 为 legacy
src/zephyr/data/audit_logs/*
src/zephyr/data/telemetry/*

# P6b 治本：autonomy_core 运行时缓存/状态（代码运行时自动生成，不应入库）
#ARCH-033: 文件迁移到 skills/ 子目录后更新路径
src/zephyr/autonomy_core/skills/_benchmark_history.json
src/zephyr/autonomy_core/skills/_freshness.json
src/zephyr/autonomy_core/skills/_skill_cache/
data/drift_audit/*
!data/drift_audit/.gitkeep
data/drift_runbooks/*
!data/drift_runbooks/.gitkeep
data/drift_handoffs/*
!data/drift_handoffs/.gitkeep

# Audit trail — Git isolation (D-020-27)
# Audit logs must NOT be tracked by git — git reset/rebase must not delete audit history
data/audit/
data/audit_trail/

# Scheduler runtime failure snapshots (regenerable, one per failed task run)
data/failures/

# Prometheus metrics export (runtime, regenerable)
data/metrics.prom

# Secret leak scan results (runtime, regenerable, large files ~55-170MB each)
# These are scan outputs from scan_secret_leak.py; must not be committed to git
**/sec_leak_*.json

# Runtime cache and state
.audit_cache/
.zephyr/
.zephyr_secure/
.trae/session_state/
# .trae/documents/ 是 IDE 内部文档存储（AI scratchpad），非项目真源，
# 不被任何代码/规则引用；整目录忽略，已跟踪文件用 git rm --cached 退回未跟踪
.trae/documents/
logs/
# 治本（2026-07-18）：src/ 下的 logs/ 是 Python 模块目录（system_telemetry.logs），
# 非日志输出目录，MUST 纳入版本控制——否则 worktree 基于 HEAD 创建时缺此模块，
# 导致 system_telemetry/__init__.py 的 `from .logs import flush` ModuleNotFoundError
!src/zephyr/infrastructure/system_telemetry/logs/
!src/zephyr/infrastructure/system_telemetry/logs/*

# Session and journal artifacts
_journals/
_prompts/

# AI ad-hoc analysis output (regenerable market screening data, not project artifacts)
# 治本 2026-07-24 (#ARCH-WORKTREE-EXEC-DRIFT-001): ad-hoc 筛选脚本写入此目录污染 git status，
# 源头是 session 未走 worktree 隔离。忽略整个 analysis 子目录防止复发。
docs/_working/analysis/

# ============================================
# Root directory whitelist mode (#ARCH-ROOT-TEMP-WHITELIST-001, 2026-07-22)
# 治本：原枚举模式（_fix_*/_debug_*/_tmp_*/autofix_*/scan_*/fix_*/commit_*/verify_*/stage_*）
# 追不上 AI 造词速度——AI 每次用新动词前缀创建一次性脚本，枚举永远补不全。
# 白名单模式：/* 忽略根目录全部平铺文件/目录，! 例外恢复已知合法文件/目录。
# 新增合法根文件/目录时 MUST 在下方 ! 列表登记（git tracked = 合法）。
# ============================================

# 忽略根目录全部直接子项（文件+目录）
/*
# --- 合法根文件（git tracked，22 项）---
!.dockerignore
!.editorconfig
!.env.example
!.gitattributes
!.gitignore
!.importlinter
!.pre-commit-config.yaml
!.traeignore
!AGENTS.md
!CONTRIBUTING.md
!docker-compose.yml
!Dockerfile
!LICENSE
!MANIFEST.in
!py.ini
!pyproject.toml
!README.md
!requirements.txt
!requirements-demo.txt
!requirements-dev.txt
!SECURITY.md
!sitecustomize.py
# --- 合法根目录（git tracked，12 项）---
!.github/
!.trae/
!architecture_model/
!config/
!data/
!docs/
!schemas/
!scripts/
!session_logs/
!src/
!tests/
!tmp/

# Depgraph dirty flag (runtime state file written by depgraph writers to signal
# reconciler that DB was modified outside apply_depgraph.py; regenerable runtime
# state, must not be tracked). 治本 2026-07-19 Group F.
data/databases/depgraph_dirty.flag

# AI tool directories
.roo/

# Knowledge graph runtime
memory_graph.json

# Vector DB data (runtime)
data/vector_db/
# 5.29.2 修复：漏忽略 e2e_test 目录（HNSW 二进制索引）
data/vector_db_e2e_test/

# FAISS semantic test vector index binaries (regenerable runtime artifacts)
data/semantic_test/

# Governance watchdog snapshots
scripts/governance/meta/_backups/
# Runtime-generated hash snapshot (validate_gate_engine_external.py _SNAPSHOT_PATH)
scripts/governance/meta/gate_engine_hashes.json
#ARCH-041: backup_runtime_state.py 默认输出路径（治标，git history 是真源）
tmp/runtime_backups/

# tmp/ 全目录忽略（治本 2026-07-05，AI-03 审计 P13）
# tmp/ 是 task_bound 一次性脚本退役区，运行时产物不入库。
# 历史教训：commit 6846813fac 曾退役 21 脚本但未补 .gitignore，导致后续 90+ 脚本再次入库。
# 保留 tmp/.gitkeep 维持目录结构；新增永久文件需 --skip-gitignore 或显式 !tmp/<file> 例外。
tmp/*
!tmp/.gitkeep

# Script warn-only results
*_warn_result.json

# Data test artifacts
data/test_audit_bridge/

# Watchdog heartbeat files
data/telemetry/.watchdog_*

# Demo directory
demos/

# Temp directories
temp/

# Code dedup benchmark
data/code_dedup_benchmark_history.json

# Generated dependency graph (regenerate with generate_project_depgraph.py)
# v2.3.0: 4.57MB, previously 150MB+ excluded — now small enough for git
data/asset_index/archive/

# Depgraph migration process backups (transient, pre-migration safety dumps)
data/backups/depgraph_pre_variant_patch_*.sql

# ML model files (4GB+, Trae indexing OOM risk)
models/

# Runtime cache (walk_cache.json 400MB+, regenerate on demand)
data/cache/

# Red-blue adversarial test runtime (trigger_queue/bypass_logs/scheduler_state)
data/red_blue/

# E2E test vector index binaries (regenerable, large)
data/e2e_test/

# PostgreSQL secrets (P2 migration — MOD-DB_DEPGRAPH_PG)
# Contains connection credentials; never commit to repository
config/.env.postgres
# ClickHouse secrets (P1-7 修复 — 消除硬编码)
# Contains connection credentials; never commit to repository
config/.env.clickhouse
# Restic backup repository password (MOD-INF-043 灾备备份系统)
# Contains encryption key; never commit to repository
config/.env.restic
# ClickHouse backup S3 (MinIO) credentials (MOD-INF-043 CH backup pipeline)
# Contains S3 access keys; never commit to repository
config/.env.ch_backup
# Backup runtime state (MOD-INF-043; pure runtime artifact — a tracked state file
# gets reset by concurrent worktree merges -> 8h interval check fails -> backup storm)
data/databases/backup_state.json
# PostgreSQL native data directory (Windows install)
data/databases/postgres/
# DEBT-BACKUP-CLEANUP: ghost_autoclean 备份旧路径（已迁移到 tmp/pg_backups/，与 backup_runtime_state.py 标杆对齐）
data/databases/backups/

# Model quick exam profiles (runtime data, regenerable; same policy as data/brain/passports/)
data/brain/quick_profiles/*

# ClickHouse system artifacts (metadata dumps, access control, configs leaked to workdir)
access/
metadata/
preprocessed_configs/
status
uuid

# Architecture health dashboard snapshots (timestamped, regenerable; latest.json is tracked)
data/architecture_health/dashboard_*.json

# Docker Compose local override (5.34.2 — 本地私有覆盖，禁止入库；示例见 config/infra/docker-compose.override.example.yml)
docker-compose.override.yml
docker-compose.override.yaml

# C4-2 治本（2026-07-20）：runtime 遥测产物 gitignore 闭环
# 病根：runtime_violation_snapshot/health_snapshots/audit_logs 等 reconciler 运行时产物
# 既未被 batched_auto_committer commit（纯运行时产物，不应入库），也未被 .gitignore
# 排除，导致 git status 噪音 + 误入库风险（违反 trae_053 双轨判定——批量兜底缺失）。
# 治本：分时快照忽略（timestamped, regenerable），保留 latest.json/baseline_*.yaml 等
# "最新状态"文件入库。已 tracked 的历史文件不强制 git rm --cached（渐进式治本）。
# 关联裁定：#ARCH-GATE-ABUSE-SYSTEMIC-AUDIT-001 Phase 4 C4-2

# Runtime violation snapshots (timestamped, regenerable; latest.json + baseline_*.yaml tracked)
data/runtime_violation_snapshot/snapshot_*.json

# Health snapshots (timestamped, regenerable; latest.json tracked)
data/health_snapshots/health_*.json

# Audit logs (runtime, regenerable; timestamped ai_audit_*.jsonl)
data/audit_logs/ai_audit_*.jsonl

# Rollback trust score runtime state (regenerable; trust_score.json 下划线版本 tracked)
data/rollback/trust/trust-score.json

# ============================================
# Backup system v2.0 + governance auto-sync (2026-07-28)
# ============================================

# System config snapshots (regenerable via ch_vm_ssh.py --sync-config;
# .xml/.conf not allowed in config/ by DIRECTORY-CONTRACT gate DCR-005)
config/system_configs/

# Local fallback cache (runtime data for market data fallback, regenerable)
data/local_fallback/

# SLA metrics auto-sync product (regenerable, managed by background process)
scripts/governance/meta/sla_metrics.jsonl

# Governance scan reports (auto-generated by run_all.py, regenerable)
scripts/governance/reports/

# Zoomable HTML (derived from .md by zoomable_html.py, regenerable, 3.5MB each)
# HTML 集中在 _zoomable_html/ 子文件夹，与 .md 分离；生成器生成 md 时联动生成
# 通用规则：所有 _zoomable_html/ 子目录均不入库（含域文档/交易决策架构/全景图等）
docs/**/_zoomable_html/

# Local doc HTTP server script (dev-local viewing tool for zoomable-HTML browser links; regenerable)
scripts/serve_docs_http.bat

# Generated panorama alignment report (regenerable by align_panoramas.py)
docs/02_enterprise_architecture/generated/
