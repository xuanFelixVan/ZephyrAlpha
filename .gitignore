!data/drift_audit/.gitkeep
data/drift_runbooks/*
!data/drift_runbooks/.gitkeep
data/drift_handoffs/*
!data/drift_handoffs/.gitkeep

# Audit trail — Git isolation (D-020-27)
# Audit logs must NOT be tracked by git — git reset/rebase must not delete audit history
data/audit/
data/audit_trail/

# Scheduler runtime failure snapshots (regenerable, one per failed task run)
data/failures/

# Auto-fix WAL (Write-Ahead Log) runtime state, continuously written, must not be tracked
data/auto_fix/wal/

# Prometheus metrics export (runtime, regenerable)
