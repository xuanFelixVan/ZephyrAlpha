        "owner": "l00-data-source"
      },
      {
        "id": "INV-015",
        "category": "boundary_integrity",
        "statement": "AISG 拦截门禁：所有 AI 生成的代码 / 指令必须经 L10 AISG security_gateway 拦截验证后才能执行",
        "priority": "P0",
