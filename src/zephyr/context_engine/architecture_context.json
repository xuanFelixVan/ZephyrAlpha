        "priority": "P0",
        "enforcement": "arch_guard",
        "fitness_function_path": "scripts/arch_guard/check_fe_acl_boundary.py",
        "owner": "l08-human-ai-interface"
      },
      {
        "id": "INV-007",
        "category": "idempotency",
        "statement": "所有跨层事件必须携带幂等 Key（Idempotency Key）：防止重复处理",
        "priority": "P1",
        "enforcement": "fitness_function",
        "fitness_function_path": "scripts/arch_guard/fitness_functions/check_idempotency_key.py",
        "owner": "shared-contracts"
      },
      {
        "id": "INV-008",
        "category": "boundary_integrity",
        "statement": "跨层依赖方向：低层不得 import 高层（L00 不得 import L04+），依赖只能向上",
        "priority": "P0",
        "enforcement": "arch_guard",
        "fitness_function_path": "scripts/arch_guard/import_linter/layer_boundary_check.py",
        "owner": "l01-infrastructure"
      },
      {
        "id": "INV-009",
        "category": "capital_safety",
        "statement": "OCP 契约冻结：shared/contracts/ 中的接口一旦 release，不得修改签名（只能扩展）",
        "priority": "P0",
        "enforcement": "fitness_function",
        "fitness_function_path": "scripts/arch_guard/fitness_functions/check_ocp_signatures.py",
        "owner": "shared-contracts"
      },
      {
        "id": "INV-010",
        "category": "data_integrity",
        "statement": "PIT 契约统一：Cold / Warm / Hot 三平面必须共享 shared/contracts/ canonical schema，不允许任何平面独立发明 schema",
        "priority": "P0",
        "enforcement": "arch_guard",
        "fitness_function_path": "scripts/arch_guard/check_schema_consistency.py",
        "owner": "shared-contracts"
      },
      {
        "id": "INV-011",
        "category": "boundary_integrity",
        "statement": "Cold → Hot 禁止直接通信：Cold Path 输出必须先落 Warm Path 并经影子验证后方可进入 Hot Path",
        "priority": "P0",
        "enforcement": "arch_guard",
        "fitness_function_path": "scripts/arch_guard/check_cross_plane_communication.py",
        "owner": "l13-experiment-pipeline"
      },
      {
        "id": "INV-012",
        "category": "boundary_integrity",
        "statement": "Hot Path 禁止同步调用 Python 代码：Hot 路径严禁直接调用任何 Python asyncio 代码",
        "priority": "P0",
        "enforcement": "arch_guard",
        "fitness_function_path": "scripts/arch_guard/check_hot_path_purity.py",
        "owner": "l04-risk-management"
      },
      {
        "id": "INV-013",
        "category": "capital_safety",
        "statement": "风控参数三平面一致性：Cold 回测 / Warm 实盘 / Hot 拦截必须使用同一 config/risk_params.yaml 参数",
        "priority": "P0",
        "enforcement": "fitness_function",
        "fitness_function_path": "scripts/arch_guard/fitness_functions/check_risk_params_consistency.py",
        "owner": "l04-risk-management"
      },
      {
        "id": "INV-014",
        "category": "data_integrity",
        "statement": "Survivorship Bias 零容忍：回测数据集必须包含退市/停牌标的，不得使用存活者偏差数据",
