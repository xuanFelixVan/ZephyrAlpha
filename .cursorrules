# ZephyrAlpha Project Rules for Cursor IDE
# Auto-generated 2026-05-07

# Encoding
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{yaml,yml,json,md}]
indent_style = space
indent_size = 2

# AI behavior
[ai]
auto_guess_encoding = false
