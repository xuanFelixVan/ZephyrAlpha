# 清风量化交易系统 v4.0 - 环境变量示例
# 复制此文件为 .env 并填入实际值

# ==================== 数据源Token ====================
TUSHARE_TOKEN=your_tushare_token_here

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite:///./data/quant.db
DUCKDB_PATH=./data/quant_duckdb

# ==================== 系统配置 ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/system/quant.log
LOG_ROTATION=00:00
LOG_RETENTION=30 days

# ==================== 交易配置 ====================
INITIAL_CAPITAL=1000000
COMMISSION_RATE=0.0003
STAMP_TAX=0.001

# ==================== 模拟/实盘模式 ====================
# backtest: 回测模式
# simulation: 模拟交易
# paper: 纸带交易
# live: 实盘交易
TRADING_MODE=backtest

# ==================== API配置 ====================
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=your_api_key_here

# ==================== 邮件通知（可选） ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_password
EMAIL_TO=notify@example.com

# ==================== 短信通知（可选） ====================
SMS_API_KEY=your_sms_api_key
SMS_PHONE=your_phone_number
