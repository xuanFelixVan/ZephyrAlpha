# ============================================
# ZephyrAlpha 环境变量模板
# 复制为 .env 并填入实际值
# .env 已列入 .gitignore，不会被提交
# ============================================

# --- AI API 密钥（按需配置）---
# DeepSeek（主力生产模型，M1-M4 + M6/M8-M11）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# GLM / 智谱（深度审查模型，M5 + M7）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Anthropic Claude（特种救援模型，失败3次/安全标签/实验标签时启用）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI（备用模型）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# KIMI_API_KEY=sk-...

# --- 数据源 API 密钥（免费数据源，按需配置）---
# 免费新闻/行情数据源；通过 zephyr.shared.security.secrets.get_secret() 读取
# Tiingo（美股行情/新闻，免费带配额）
TIINGO_API_KEY=
# Finnhub（新闻/公司基本面，免费带配额）
FINNHUB_API_KEY=
# Newsdata.io（新闻，免费带配额）
NEWSDATA_API_KEY=
# Alpha Vantage（行情/新闻/情绪，免费带配额）
ALPHAVANTAGE_API_KEY=
# NewsAPI.org（新闻，免费带配额）
NEWSAPI_KEY=

# iFind 同花顺（试用账号，有限制）
IFIND_USERNAME=
IFIND_PASSWORD=

# 百度网盘开放平台（Baidu Pan API，文件上传/下载/分享/搜索）
# 应用凭证（长期有效），通过 zephyr.shared.security.secrets.get_secret() 读取
BDPAN_APP_ID=
BDPAN_APP_KEY=
BDPAN_SECRET_KEY=
BDPAN_SIGN_KEY=
# access_token / refresh_token 通过授权流程获取（30天过期，需用 refresh_token 刷新）
# 手动维护——暂无自动刷新模块，过期后需手动用 refresh_token 刷新或重新授权
BDPAN_ACCESS_TOKEN=
BDPAN_REFRESH_TOKEN=

# --- 数据库与存储 ---
# ZEPHYR_DB_PATH=.runtime/db/zephyr.db
# ZEPHYR_DOS_DIRECTIVE_DIR=config

# --- 量化交易终端（QMT）---
# .env.qmt 用于存储 QMT 终端连接参数（独立于主 .env）
# 创建 .env.qmt 并填入 QMT 相关配置，该文件已列入 .gitignore

# --- 日志与调试 ---
# ZEPHYR_LOG_LEVEL=INFO

# --- 审计安全 ---
# 生产环境必须设置，开发环境使用默认key（会打 warning 日志）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
ZEPHYR_AUDIT_HMAC_SECRET=

# --- MCP 服务端配置（MOD-INF-013 §7）---
# ZEPHYR_DEBUG_MCP=false
# ZEPHYR_MCP_LOG_LEVEL=INFO
# ZEPHYR_MCP_TIMEOUT=30
# ZEPHYR_MCP_RATE_LIMIT_QPS=10
# ZEPHYR_MCP_AUDIT_DIR=logs/mcp_audit
