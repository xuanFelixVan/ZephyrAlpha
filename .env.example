# ============================================
# ZephyrAlpha 环境变量模板
# 复制为 .env 并填入实际值
# .env 已列入 .gitignore，不会被提交
# ============================================

# --- AI API 密钥（按需配置）---
# DeepSeek（主力生产模型，M1-M4 + M6/M8-M11）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# GLM / 智谱（深度审查模型，M5 + M7；免费主力 glm-4.7-flash 200K，1 并发）
# Key 管理：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.7-flash

# 腾讯混元（hunyuan-lite 永久免费，5 并发，256K；腾讯云 API 3.0 签名鉴权，非 OpenAI 兼容）
# 开通：https://console.cloud.tencent.com/hunyuan/start ｜ 密钥：https://console.cloud.tencent.com/cam/capi
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
HUNYUAN_MODEL=hunyuan-lite

# 百度千帆 ERNIE（bce-v3 Bearer Key，OpenAI 兼容；ernie-speed/lite/tiny/3.5-8k 永久免费，QPS 50）
# 控制台：https://console.bce.baidu.com/qianfan/
QIANFAN_API_KEY=
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
QIANFAN_MODEL=ernie-speed-128k

# Google AI Studio（免费层最慷慨：15-30 RPM / 1500 次/天，1M 上下文；免费层 prompt 可能被用于产品改进）
# Key 管理：https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_MODEL=gemini-3.5-flash

# Groq（LPU 推理最快 ~320 tok/s，免费层限速不限量，OpenAI 兼容）
# Key 管理：https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral（每月 $10 免费额度；免费模式默认可能拿数据训练，控制台可退出）
# Key 管理：https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-large-latest

# Cohere（Trial key：1000 次/月，20 RPM，仅非商用；OpenAI 兼容端点 https://api.cohere.ai/compatibility/v1）
# Key 管理：https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_MODEL=command-a-03-2025

# OpenRouter（免费模型聚合：:free 模型 20 RPM；50 次/天，一次性充 $10 → 1000 次/天）
# 免费模型清单：https://openrouter.ai/models?max_price=0
# Key 管理：https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Anthropic Claude（特种救援模型，失败3次/安全标签/实验标签时启用）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI（备用模型）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# KIMI_API_KEY=sk-...

# --- 数据源 API 密钥（免费数据源，按需配置）---
# 免费新闻/行情数据源；通过 zephyr.shared.security.secrets.get_secret() 读取
# Tiingo（美股行情/新闻，免费带配额）
TIINGO_API_KEY=
# Finnhub（新闻/公司基本面，免费带配额）
FINNHUB_API_KEY=
# Newsdata.io（新闻，免费带配额）
NEWSDATA_API_KEY=
# Alpha Vantage（行情/新闻/情绪，免费带配额）
ALPHAVANTAGE_API_KEY=
# NewsAPI.org（新闻，免费带配额）
NEWSAPI_KEY=


# Tushare（申万行业分类+成分股映射，2000积分 ¥200/年）
# 购买：https://tushare.pro/weborder/#/permission/buy
# 通过 zephyr.shared.security.secrets.get_required_secret() 读取
TUSHARE_TOKEN=

# 通达信插件目录（tqcenter 板块数据源，可选，默认 E:\tdx\PYPlugins\user）
TDX_PLUGIN_DIR=

# FRED（美联储经济数据库，免费注册 API key）
# 注册：https://fred.stlouisfed.org/docs/api/api_key.html
# 通过 zephyr.shared.security.secrets.get_secret_or_default() 读取（可选，无 key 用免费限额）
# 世界银行数据无需 key，FRED 数据需 key
FRED_API_KEY=

# EIA（美国能源信息署，免费注册 API key）
# 注册：https://www.eia.gov/opendata/register.php
# 通过 zephyr.shared.security.secrets.get_secret_or_default() 读取
# 石油库存/价格/天然气库存等能源数据
EIA_API_KEY=

# 和风天气（QWeather，免费注册 API key）
# 注册：https://dev.qweather.com
# 通过 zephyr.shared.security.secrets.get_secret_or_default() 读取
# 实时天气+7天预报，免费版无历史API——必须每日积累
QWEATHER_API_KEY=
# 专属 API Host（控制台-设置 中查看，2026 年起公共地址 devapi.qweather.com 已弃用）
# 格式如 abc1234xyz.def.qweatherapi.com
QWEATHER_API_HOST=

# 百度网盘开放平台（Baidu Pan API，文件上传/下载/分享/搜索）
# 应用凭证（长期有效），通过 zephyr.shared.security.secrets.get_secret() 读取
BDPAN_APP_ID=
BDPAN_APP_KEY=
BDPAN_SECRET_KEY=
BDPAN_SIGN_KEY=
# access_token / refresh_token 通过授权流程获取（30天过期，需用 refresh_token 刷新）
# 手动维护——暂无自动刷新模块，过期后需手动用 refresh_token 刷新或重新授权
BDPAN_ACCESS_TOKEN=
BDPAN_REFRESH_TOKEN=

# --- 数据库与存储 ---
# ZEPHYR_DB_PATH=.runtime/db/zephyr.db
# ZEPHYR_DOS_DIRECTIVE_DIR=config

# --- PostgreSQL（depgraph 数据库，P2 迁移后真源）---
# 5.34.9 修复：原 .env.example 未文档化 PG 配置，新开发者无法推断 PG 连接
# PG 配置真源为 config/.env.postgres（已列入 .gitignore，不会提交）
# 模板：复制 config/.env.postgres 为本地文件并填入实际值
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=depgraph
# POSTGRES_USER=zephyr
# POSTGRES_PASSWORD=<请填入实际密码>
# 说明：depgraph_schema.py 的 _load_pg_config() 从 config/.env.postgres 读取
#       测试环境可用 config/.env.postgres.test 指向独立测试库（5.34.4 待修复）

# --- 量化交易终端（QMT）---
# .env.qmt 用于存储 QMT 终端连接参数（独立于主 .env）
# 创建 .env.qmt 并填入 QMT 相关配置，该文件已列入 .gitignore

# --- 日志与调试 ---
# ZEPHYR_LOG_LEVEL=INFO

# --- 环境与运行时（5.155.19 修复：原18+env未文档化）---
# 环境标识（dev/staging/production/test），见 zephyr.shared.foundation.env
# ZEPHYR_ENV=dev
# 项目根目录（SSoT: zephyr.shared.io.paths.REPO_ROOT）
ZEPHYR_PROJECT_ROOT=
# SQLite数据库路径
# ZEPHYR_DB_PATH=.runtime/db/zephyr.db
# DOS指令目录
# ZEPHYR_DOS_DIRECTIVE_DIR=config
# 指标输出目录
# ZEPHYR_METRICS_DIR=data/metrics
# 熔断器失败阈值（int）
# ZEPHYR_CBG_FAILURE_THRESHOLD=3
# 深度采样数（int）
# ZEPHYR_DEPTH_SAMPLES=1
# 门禁完整性信任根（设置后启用gate文件完整性校验）
# ZEPHYR_TRUST_ROOT=
# 能力强制执行开关
# ZEPHYR_ENFORCE_CAPABILITY=false
# 回滚操作者session标识
# ZEPHYR_OWNER_SESSION_ID=

# --- 告警触达通道（audit 8.3，#ARCH-CH-023，2026-07-23）---
# 密钥走 .env（禁止入库）；未配置的通道静默跳过（告警仅写日志+failure file）。
# 配置后 ERROR/CRITICAL 级别告警将触达人，不止写日志。
# 飞书自定义机器人 webhook（群设置 > 群机器人 > 添加机器人 > 自定义机器人）
ZEPHYR_FEISHU_WEBHOOK=
# SMTP 邮件告警（STARTTLS，端口 587 默认）
ZEPHYR_SMTP_HOST=
ZEPHYR_SMTP_PORT=587
ZEPHYR_SMTP_USER=
ZEPHYR_SMTP_PASSWORD=
# 告警收件人邮箱（多个用逗号分隔）
ZEPHYR_ALERT_RECIPIENT=
# 发件人邮箱（默认同 ZEPHYR_SMTP_USER）
# ZEPHYR_ALERT_SENDER=
# 告警网络/SMTP 超时秒数（默认 5）
# ZEPHYR_ALERT_TIMEOUT=5

# --- 数字货币交易所 API ---
# OKX 交易所（94号 Q1 裁定 2026-08-31 修订：OKX 主+币安备[待开发]）
# 获取：OKX 官网 → 个人中心 → API → 创建 V5 API Key
# 权限按需配置（划转/赚币/借贷/读取/提现/交易），建议最小化
# IP 白名单可选（动态公网 IP 不设）
OKX_API_KEY=
OKX_SECRET_KEY=

# --- 可观测性栈（Grafana 管理员口令，AI-01 W2 治本 2026-08-01）---
# docker-compose.yml 的 grafana 服务用 ${GRAFANA_ADMIN_PASSWORD:?...} fail-fast 读取——
# 未设置或空值会导致 `docker compose up` 报错退出（防静默弱口令兜底）。
# 本地开发：填一个强口令（仅本地可见，不入库）；生产/共享环境：通过环境变量注入。
# 详见 SECURITY.md 开发侧约定。
GRAFANA_ADMIN_PASSWORD=

# --- 审计安全 ---
# 生产环境必须设置，开发环境使用默认key（会打 warning 日志）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
ZEPHYR_AUDIT_HMAC_SECRET=
# 防篡改日志 HMAC 密钥（未设置时使用兜底派生密钥并打 warning）
# 生成方法同上
ZEPHYR_TAMPER_HMAC_SECRET=

# --- MCP 服务端配置（MOD-INF-013 §7）---
# ZEPHYR_DEBUG_MCP=false
# ZEPHYR_MCP_LOG_LEVEL=INFO
# ZEPHYR_MCP_TIMEOUT=30
# ZEPHYR_MCP_RATE_LIMIT_QPS=10
# ZEPHYR_MCP_AUDIT_DIR=logs/mcp_audit

# ============================================
# 基础设施服务凭证（不在本文件，在 config/.env.{service}）
# ============================================
# 本文件(.env)只存放第三方 API token + 运行时密钥。
# 基础设施服务凭证分文件存放，不自动加载（按需 get_secret_from_file 读取）。
#
# 完整密钥清单与读取规范见：SECRETS.md
# 结构化密钥注册表：config/secret_registry.yaml
#
# 文件分布：
#   config/.env.postgres    — PostgreSQL 凭证（9 KEY）
#   config/.env.clickhouse  — ClickHouse 凭证（10 KEY）
#   config/.env.redis       — Redis 凭证（7 KEY）
#   config/.env.qmt         — QMT 量化交易终端（4 KEY）
#   config/.env.ch_backup   — ClickHouse 备份凭证（6 KEY）
#
# 新增密钥流程（3 步，详见 SECRETS.md §3）：
#   1. 加 KEY 到对应 .env 文件
#   2. 更新 .env.example（本文件）
#   3. 更新 config/secret_registry.yaml
