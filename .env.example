# ============================================
# ZephyrAlpha 环境变量模板
# 复制为 .env 并填入实际值
# .env 已列入 .gitignore，不会被提交
# ============================================

# --- AI API 密钥（按需配置）---
# DeepSeek（主力生产模型，M1-M4 + M6/M8-M11）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# GLM / 智谱（深度审查模型，M5 + M7）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Anthropic Claude（特种救援模型，失败3次/安全标签/实验标签时启用）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI（备用模型）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# KIMI_API_KEY=sk-...

# --- 数据源 API 密钥（免费数据源，按需配置）---
# 免费新闻/行情数据源；通过 zephyr.shared.security.secrets.get_secret() 读取
# Tiingo（美股行情/新闻，免费带配额）
TIINGO_API_KEY=
# Finnhub（新闻/公司基本面，免费带配额）
FINNHUB_API_KEY=
# Newsdata.io（新闻，免费带配额）
NEWSDATA_API_KEY=
# Alpha Vantage（行情/新闻/情绪，免费带配额）
ALPHAVANTAGE_API_KEY=
# NewsAPI.org（新闻，免费带配额）
NEWSAPI_KEY=

# iFind 同花顺（试用账号，有限制）
IFIND_USERNAME=
IFIND_PASSWORD=

# 百度网盘开放平台（Baidu Pan API，文件上传/下载/分享/搜索）
# 应用凭证（长期有效），通过 zephyr.shared.security.secrets.get_secret() 读取
BDPAN_APP_ID=
BDPAN_APP_KEY=
BDPAN_SECRET_KEY=
BDPAN_SIGN_KEY=
# access_token / refresh_token 通过授权流程获取（30天过期，需用 refresh_token 刷新）
# 手动维护——暂无自动刷新模块，过期后需手动用 refresh_token 刷新或重新授权
BDPAN_ACCESS_TOKEN=
BDPAN_REFRESH_TOKEN=

# --- 数据库与存储 ---
# ZEPHYR_DB_PATH=.runtime/db/zephyr.db
# ZEPHYR_DOS_DIRECTIVE_DIR=config

# --- PostgreSQL（depgraph 数据库，P2 迁移后真源）---
# 5.34.9 修复：原 .env.example 未文档化 PG 配置，新开发者无法推断 PG 连接
# PG 配置真源为 config/.env.postgres（已列入 .gitignore，不会提交）
# 模板：复制 config/.env.postgres 为本地文件并填入实际值
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=depgraph
# POSTGRES_USER=zephyr
# POSTGRES_PASSWORD=<请填入实际密码>
# 说明：depgraph_schema.py 的 _load_pg_config() 从 config/.env.postgres 读取
#       测试环境可用 config/.env.postgres.test 指向独立测试库（5.34.4 待修复）

# --- 量化交易终端（QMT）---
# .env.qmt 用于存储 QMT 终端连接参数（独立于主 .env）
# 创建 .env.qmt 并填入 QMT 相关配置，该文件已列入 .gitignore

# --- 日志与调试 ---
# ZEPHYR_LOG_LEVEL=INFO

# --- 环境与运行时（5.155.19 修复：原18+env未文档化）---
# 环境标识（dev/staging/production/test），见 zephyr.shared.foundation.env
# ZEPHYR_ENV=dev
# 项目根目录（SSoT: zephyr.shared.io.paths.REPO_ROOT）
ZEPHYR_PROJECT_ROOT=
# SQLite数据库路径
# ZEPHYR_DB_PATH=.runtime/db/zephyr.db
# DOS指令目录
# ZEPHYR_DOS_DIRECTIVE_DIR=config
# 指标输出目录
# ZEPHYR_METRICS_DIR=data/metrics
# 熔断器失败阈值（int）
# ZEPHYR_CBG_FAILURE_THRESHOLD=3
# 深度采样数（int）
# ZEPHYR_DEPTH_SAMPLES=1
# 门禁完整性信任根（设置后启用gate文件完整性校验）
# ZEPHYR_TRUST_ROOT=
# 能力强制执行开关
# ZEPHYR_ENFORCE_CAPABILITY=false
# 回滚操作者session标识
# ZEPHYR_OWNER_SESSION_ID=
# 飞书告警webhook
# ZEPHYR_FEISHU_WEBHOOK=
# SMTP告警配置
# ZEPHYR_SMTP_HOST=
# ZEPHYR_SMTP_PORT=587
# ZEPHYR_SMTP_USER=
# ZEPHYR_SMTP_PASSWORD=

# --- 审计安全 ---
# 生产环境必须设置，开发环境使用默认key（会打 warning 日志）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
ZEPHYR_AUDIT_HMAC_SECRET=

# --- MCP 服务端配置（MOD-INF-013 §7）---
# ZEPHYR_DEBUG_MCP=false
# ZEPHYR_MCP_LOG_LEVEL=INFO
# ZEPHYR_MCP_TIMEOUT=30
# ZEPHYR_MCP_RATE_LIMIT_QPS=10
# ZEPHYR_MCP_AUDIT_DIR=logs/mcp_audit
