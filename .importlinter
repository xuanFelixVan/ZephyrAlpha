[importlinter]
root_package = zephyr

# ZephyrAlpha import-linter 配置
# 真源：src/zephyr/ 实际包结构（业务包随 src/zephyr/ 演进，禁止写死包数计数——会漂移）
# 维护：新增/重命名/删除 src/zephyr/ 顶层业务包时 MUST 同步 forbidden_modules（shared 除外）
#   生成校验命令（PowerShell）：Get-ChildItem src/zephyr -Directory | ? { $_.Name -notmatch '^__|^\.|^_' -and (Test-Path "$($_.FullName)/__init__.py") -and $_.Name -ne 'shared' } | % { "zephyr.$($_.Name)" } | Sort-Object
# 仅保留最核心约束：shared 层禁止 import 业务层（向下依赖原则，AGENTS.md §7 ZephyrBaseError 真源归一）
# 分层契约的完整守护由 depgraph (PostgreSQL) 拓扑验证承担（apply_depgraph.py，AGENTS.md §11）
# 未接入 pre-commit（warn-only 诊断用途）；如需强制请登记 GATE-IMPORT-LAYER capability
# 治本（2026-07-05）：原配置引用 capacity_assurance/risk_engine/order_execution/ui/analytics/portfolio
#   等不存在的包名，与实际包结构漂移，配置完全失效。现对齐实际包名，仅保留 shared 层约束。

[importlinter:contract:shared-no-business]
name = 共享层不能导入业务模块（向下依赖原则）
type = forbidden
source_modules =
    zephyr.shared
forbidden_modules =
    zephyr.alt_data
    zephyr.autonomy_core
    zephyr.backtest
    zephyr.clone_guard
    zephyr.compliance
    zephyr.cross_asset
    zephyr.data
    zephyr.data_eng
    zephyr.data_governance
    zephyr.data_security
    zephyr.digital_twin
    zephyr.ex_core
    zephyr.ex_sor
    zephyr.execution_simulation
    zephyr.experiment_tracking
    zephyr.factor
    zephyr.feedback_loop
    zephyr.frontend
    zephyr.gov_audit
    zephyr.gov_code_quality
    zephyr.gov_drift
    zephyr.gov_enforcement
    zephyr.gov_rule
    zephyr.governance
    zephyr.infrastructure
    zephyr.integration
    zephyr.intelligence
    zephyr.market_data
    zephyr.ml_serve
    zephyr.ml_train
    zephyr.orchestrator
    zephyr.pf_alloc
    zephyr.pf_core
    zephyr.position
    zephyr.red_blue_validator
    zephyr.regime
    zephyr.reporting
    zephyr.research
    zephyr.risk
    zephyr.runtime
    zephyr.security
    zephyr.sell_decision
    zephyr.signal_ashare
    zephyr.signal_fundamental
    zephyr.signal_quality
    zephyr.simulation
    zephyr.trading
# ignore_imports（AI-01 S1-3 治本，2026-08-01）：以下 4 处为已记录的跨层技术债，
#   治本（下沉类型到 shared / 重构 _cross_layer）属独立架构专项，超出 S1 机制治本边界。
#   显式豁免使 lint-imports 可 PASS、未来新增违规仍被检测、豁免项可追踪。
#   来源：§5.152（trae_081_audit_dimensions_framework.yaml 维度 5.152）+ 各文件 gate 规避注释。
#   注：lint-imports 比 NO-UPWARD-IMPORT gate 更强（分析完整 import graph，检测 Import 节点
#   + importlib 动态导入），故 gate 规避手段在此契约下会暴露——治本后应移除对应豁免。
ignore_imports =
    zephyr.shared.security.secrets -> zephyr.feedback_loop.security.secret_rotation
    zephyr.shared.contracts.protocols -> zephyr.gov_enforcement.rule_enforcement.gate_types
    zephyr.shared.protocols.a2a.a2a_coordination -> zephyr.gov_enforcement.rule_enforcement.task_types
    zephyr.shared._cross_layer.ml_experiment_pipeline -> zephyr.ml_train.trainer_base
